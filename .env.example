# =============================================================================
# Arogya — Environment Configuration Template (.env.example)
# Problem Statement: SIH26047 (Patient Case-Taking Software)
# 
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.local:
#    cp .env.example .env.local
# 2. Populate real production secrets in your secure environment (e.g. Vercel Project Settings)
# 3. NEVER commit your actual .env or .env.local file with production credentials to Git!
# =============================================================================

# Application Identity & Branding
NEXT_PUBLIC_APP_NAME="Arogya"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_FACILITY_NAME="General OPD - Arogya Care Unit"
NEXT_PUBLIC_FACILITY_CODE="AROGYA-OPD-104"

# Database Configuration (PostgreSQL with Prisma)
# In production on Vercel, use a managed PostgreSQL service (Neon, Supabase, AWS RDS, etc.)
# Include sslmode=require for cloud-hosted PostgreSQL instances.
DATABASE_URL="postgresql://username:password@db-host.example.com:5432/arogya_db?sslmode=require&schema=public"

# Authentication & Session Security
# Generate a cryptographically secure 32+ character random string: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
SESSION_SECRET="replace-with-a-secure-random-32-character-secret-key"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-character-secret-key"
NEXTAUTH_URL="https://your-deployment-domain.vercel.app"

# Operating Mode
# Set DEMO_MODE to "true" for standalone demonstrations without requiring PostgreSQL.
# In DEMO_MODE, in-memory mock datasets and demo accounts are used seamlessly.
# Set DEMO_MODE to "false" in full production connected to PostgreSQL database.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# AI Provider Abstraction (Decoupled LLM Architecture)
# Supported options: "mock" (default/offline), "openai", "anthropic", "gemini", "ollama"
AI_PROVIDER_DEFAULT="mock"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL=""
AI_PROVIDER_MODEL="clinical-structuring-v1"

# Voice / Speech-to-Text Provider Abstraction
# Supported options: "webspeech" (browser-native, zero-cost), "whisper", "deepgram"
VOICE_PROVIDER_DEFAULT="webspeech"
VOICE_PROVIDER_API_KEY=""
VOICE_PROVIDER_MODEL="whisper-large-v3-clinical"

# Audit Trail & Clinical Governance
AUDIT_LOG_ENABLED="true"
COMPLIANCE_MODE="INTEROPERABILITY_READY"
